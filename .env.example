LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_MAX_TOKENS=8192
LLM_THINKING=disabled
# Estimated input + complete output context budget, independent of max_tokens.
MEMORY_CONTEXT_BUDGET_TOKENS=20000
# Default staged planning and review; true is the historical one-call experiment.
SINGLE_PASS_PLANNING=false
# Tool batch allowance for staged planning, review and local repair.
PLANNING_ROUNDS=8
# Optional: uncomment and set a number to estimate LLM token costs.
# LLM_INPUT_USD_PER_1M_TOKENS=
# LLM_OUTPUT_USD_PER_1M_TOKENS=
# Optional: use an ASCII-only path for Milvus Lite on Windows with a Chinese project path.
# V0_RAG_DB_DIR=C:\trip-evidence-rag

# Optional: authorized Juhe train query key; keep the real value in local .env only.
JUHE_TRAIN_API_KEY=

# 高德 Web 服务 Key：酒店地点搜索，不提供房型报价或空房
AMAP_API_KEY=
